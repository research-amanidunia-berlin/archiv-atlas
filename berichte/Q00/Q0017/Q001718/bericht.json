en kurzen Auszug von einer OECD-Webseite zu einem Bericht über die Umsetzung des koordinierten EU-Plans für künstliche Intelligenz, Band 2. Er beschreibt den thematischen Umfang, nicht die konkreten Ergebnisse des Berichts.\n\nLaut Seitenauszug untersucht der Bericht den Einsatz von KI in vier Bereichen der Europäischen Union: Landwirtschaft, Gesundheit, Fertigung und Mobilität. Als Grundlage nennt die Seite Literaturauswertungen zu den einzelnen Sektoren, Interviews mit Beteiligten und Erkenntnisse aus eigens veranstalteten Workshops.\n\nDer Auszug enthält keine Einzelbefunde, Zahlen, Empfehlungen oder Angaben dazu, wie sich der KI-Einsatz in den vier Sektoren entwickelt hat. Auch Vorgehen und Umfang der Literaturauswertungen, Interviews und Workshops werden nicht näher beschrieben. Die Seite verweist auf einen Download der vollständigen Veröffentlichung; deren Inhalt ist im bereitgestellten Quelltext jedoch nicht enthalten. Aussagen über die Resultate oder Schlussfolgerungen des Berichts lassen sich daher aus diesem Auszug nicht ableiten.","von":"Luna (gpt-6-luna, Denkstufe high), ChatGPT-Abo","stand":"2026-11-19"},"sammelfragen":{"SF-P4":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-ultra":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"amos":{"beleg":5,"beleg3":10,"verteilung":[38,46,6,5,2,1,1,1]},"subq":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"drex":{"beleg":5,"beleg3":8,"verteilung":[25,62,5,3,2,1,1,1]}},"SF-T1":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":1,"beleg3":15,"verteilung":[39,43,3,14,1,0,0,0]},"d3-ultra":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"amos":{"beleg":6,"beleg3":16,"verteilung":[21,51,12,10,2,1,2,1]},"subq":{"beleg":0,"beleg3":4,"verteilung":[32,63,1,4,0,0,0,0]}