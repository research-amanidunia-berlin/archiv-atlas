OpenAI teilen müssen.\n\nDer Zugang setzt laut Ankündigung sowohl eine Genehmigung für OpenAI Daybreak Red als auch eine Bereitstellung durch AWS voraus. Interessierte sollen einen Daybreak-Antrag stellen oder ihr OpenAI- beziehungsweise AWS-Kontaktteam zur Teilnahmeberechtigung ansprechen. Nach der Genehmigung muss der AWS-Kontakt den Zugang aktivieren; die Daybreak-Red-Genehmigung allein schaltet den Modellzugriff auf AWS nicht frei. Der Bericht nennt keine unabhängige Leistungsbewertung, konkreten Testergebnisse oder näheren Angaben zu den Voraussetzungen für die Zulassung. Die beschriebenen Fähigkeiten und Datenschutzbedingungen werden als Angaben von OpenAI wiedergegeben.","von":"Luna (gpt-6-luna, Denkstufe high), ChatGPT-Abo","stand":"2026-11-19"},"sammelfragen":{"SF-P4":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-ultra":null,"jev":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"amos":{"beleg":5,"beleg3":11,"verteilung":[41,41,7,6,2,1,1,1]},"subq":{"beleg":1,"beleg3":5,"verteilung":[36,57,2,4,1,0,0,0]},"drex":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]}},"SF-T1":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":6,"beleg3":51,"verteilung":[6,27,16,45,6,0,0,0]},"d3-ultra":null,"jev":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"amos":{"beleg":9,"beleg3":23,"verteilung":[19,38,20,14,4,2,2,1]},"subq":{"beleg":2,"beleg3":6,"verteilung":[32,60,2,4,1,1,0,0]},"drex":{"beleg":4,"beleg3":9,"verteilung":[18,69,4,5,2,1,1,0]}},"SF-T2":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-ultra":null,"jev":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"amos":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"subq":{"beleg":1,"beleg3":3,"verteilung":[23,73,1,2,1,0,0,0]},"drex":{"beleg":5,"beleg3":9,"verteilung":[14,72,5,4,2,1,1,1]}},"SF-T