tscheidungsträgern helfen können, die Sicherheit von KI-Systemen zu beurteilen. Außerdem könnten sie laut Abstract die „Frontier AI Safety Commitments“ unterstützen. Welche konkrete Form diese Nachweise haben, wie sie erstellt oder geprüft werden sollen und welche Ergebnisse die Arbeit dazu vorlegt, ist im Auszug nicht enthalten. Der Abstract nennt zudem offene Forschungsfragen zur Methodik und praktischen Umsetzung. Daher lassen sich aus dem bereitgestellten Text weder Einzelheiten zum Vorgehen noch konkrete Befunde oder die Reichweite der vorgeschlagenen Ansätze ableiten.","von":"Luna (gpt-6-luna, Denkstufe high), ChatGPT-Abo","stand":"2026-11-19"},"sammelfragen":{"SF-P4":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":3,"beleg3":31,"verteilung":[11,52,6,28,3,0,0,0]},"d3-ultra":null,"jev":null,"amos":{"beleg":7,"beleg3":25,"verteilung":[18,43,14,18,3,2,1,1]},"drex":null,"subq":{"beleg":3,"beleg3":15,"verteilung":[23,59,3,12,2,1,0,0]}},"SF-T1":{"clef":{"beleg":9,"beleg3":37,"verteilung":[21,30,12,28,3,2,3,1]},"luna":{"beleg":12,"beleg3":71,"verteilung":[1,13,15,59,11,1,0,0]},"d3-ultra":null,"jev":null,"amos":{"beleg":13,"beleg3":45,"verteilung":[7,21,27,32,6,3,3,1]},"drex":null,"subq":{"beleg":5,"beleg3":22,"verteilung":[10,59,9,17,4,0,1,0]}},"SF-T2":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":20,"beleg3":77,"verteilung":[2,10,11,57,19,1,0,0]},"d3-ultra":null,"jev":null,"amos":{"beleg":9,"beleg3":33,"verteilung":[9,37,21,24,4,2,2,1]},"drex":null,"subq":{"beleg":2,"beleg3":12,"verteilung":[8,75,5,10,2,0,0,0]}},"SF-T3":{"clef":{"beleg":12,"beleg3":43,"verteilung":[20,23,14,31,3,3,4,2]},"luna":{"beleg":17,"beleg3":50,"verteilung":[16,24,10,33,13,2,1,1]},"d3-ultra":null,"jev":null,"amos":{"beleg":8,"beleg3":28,"verteilung":[11,44,17,20,3,2,2,1]},"drex":null,"subq":{"beleg":1,"beleg3":10,"verteilung":[11,75,4,9,1,0,0,0]}},"SF-H5":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"b