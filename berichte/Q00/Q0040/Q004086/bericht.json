 der Abbildungen oder die vollständige Begründung der Empfehlungen. Die Aussagen zu Leistung und Fehlern sind daher hier als im Bericht dargestellte Ergebnisse wiedergegeben, nicht unabhängig überprüfbar.","von":"Luna (gpt-6-luna, Denkstufe high), ChatGPT-Abo","stand":"2026-11-19"},"sammelfragen":{"SF-P4":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":null,"amos":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"subq":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"drex":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-ultra":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-flash":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]}},"SF-T1":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":null,"amos":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"subq":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"drex":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-ultra":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-flash":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]}},"SF-T2":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":null,"amos":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"subq":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"drex":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-ultra":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-flash":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]}},"SF-T3":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":null,"amos":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"subq":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"drex":{"beleg":3,"