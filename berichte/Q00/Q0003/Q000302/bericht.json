tober 2026, ab 16:30 Uhr in Harong, Quezon City, an einem gemeinsamen Protest gegen Pax Silica teilzunehmen. Interessierte werden gebeten, sich über einen verlinkten Google-Forms-Link anzumelden.\n\nMit den Hashtags „#NoToPaxSilica“, „#DefendAncestralLands“ und „#StandWithTheAeta“ stellt der Beitrag den Aufruf in den Zusammenhang mit Widerstand gegen Pax Silica, dem Schutz angestammter Gebiete und Solidarität mit den Aeta. Das sind Anliegen, die der Post durch seine Formulierung und Hashtags ausdrückt; weitere Begründungen oder Angaben zu Pax Silica enthält der Text nicht.\n\nDer Bericht ist eine Veranstaltungsankündigung, keine Darstellung eines bereits erfolgten Protests oder seiner Ergebnisse. Er nennt weder Veranstalter noch Ablauf, genaue Adresse, Teilnahmebedingungen oder nähere Informationen zur Anmeldung. Zwar enthält der Quelltext Bildverweise und nachgetragene Abbildungen, deren Inhalt wird darin aber nicht beschrieben. Die Zusammenfassung beschränkt sich daher auf die Angaben im Text.","von":"Luna (gpt-6-luna, Denkstufe high), ChatGPT-Abo","stand":"2026-11-19"},"sammelfragen":{"SF-P4":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":null,"amos":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"subq":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"drex":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-ultra":null,"d3-flash":null},"SF-T1":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":null,"amos":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"subq":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"drex":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"d3-ultra":null,"d3-flash":null},"SF-T2":{"clef":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"luna":{"beleg":0,"beleg3":0,"verteilung":[100,0,0,0,0,0,0,0]},"jev":null,"amos":{"bele